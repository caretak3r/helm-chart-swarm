<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>chart-test-swarm — Recommendations</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>

<header class="brand">
  <div>
    <h1>chart-test-swarm <span style="color:var(--text-muted);font-weight:400">— Recommendations</span></h1>
    <p class="hint">Actionable chart-fix suggestions from FAIL scenario results.</p>
  </div>
  {% include "_nav.html.j2" %}
</header>

<section class="recommendations">

{% if recommendations %}
{# Summary bar #}
<div class="rec-summary-bar">
  <span class="rec-summary-item rec-status-open">{{ status_counts.get('open', 0) }} Open</span>
  <span class="rec-summary-item rec-status-in_progress">{{ status_counts.get('in_progress', 0) }} In Progress</span>
  <span class="rec-summary-item rec-status-fixed">{{ status_counts.get('fixed', 0) }} Fixed</span>
  <span class="rec-summary-item rec-status-dismissed">{{ status_counts.get('dismissed', 0) }} Dismissed</span>
</div>

{# Tab bar — filters cards by status #}
<div class="rec-tabs">
  <button class="rec-tab rec-tab-active" data-tab="all" onclick="switchTab('all')">All</button>
  <button class="rec-tab" data-tab="open" onclick="switchTab('open')">Open</button>
  <button class="rec-tab" data-tab="in_progress" onclick="switchTab('in_progress')">In Progress</button>
  <button class="rec-tab" data-tab="fixed" onclick="switchTab('fixed')">Fixed</button>
  <button class="rec-tab" data-tab="dismissed" onclick="switchTab('dismissed')">Dismissed</button>
</div>

{# Filter controls #}
<div class="rec-filters">
  <label for="rec-filter-category">Category:</label>
  <select id="rec-filter-category" onchange="filterRecommendations()">
    <option value="all">All</option>
    <option value="chart-fix">chart-fix</option>
    <option value="infrastructure">infrastructure</option>
    <option value="gap-probe">gap-probe</option>
    <option value="schema-missing">schema-missing</option>
  </select>
  <label for="rec-filter-severity">Severity:</label>
  <select id="rec-filter-severity" onchange="filterRecommendations()">
    <option value="all">All</option>
    <option value="high">high</option>
    <option value="medium">medium</option>
    <option value="low">low</option>
  </select>
</div>

{# Recommendation cards #}
{% for rec in recommendations %}
<div class="rec-card" data-category="{{ rec.category }}" data-severity="{{ rec.severity }}" data-status="{{ rec.status }}">
  <div class="rec-card-header">
    <span class="rec-badge rec-badge-{{ rec.status }}">{{ rec.status }}</span>
    <span class="rec-tag rec-tag-category">{{ rec.category }}</span>
    <span class="rec-tag rec-tag-severity rec-severity-{{ rec.severity }}">{{ rec.severity }}</span>
    <span class="rec-title">{{ rec.title }}</span>
  </div>
  <details class="rec-detail-section">
    <summary class="rec-detail-toggle">Show details</summary>
    <div class="rec-detail-content">
      <p><strong>Scenario:</strong> {{ rec.scenario_id }}</p>
      <p><strong>Detail:</strong></p>
      <pre class="rec-detail-text">{{ rec.detail }}</pre>
      {% if rec.affected_objects %}
      <p><strong>Affected objects:</strong> {{ rec.affected_objects | join(', ') }}</p>
      {% endif %}
      <p><strong>Run history:</strong>
        {% for ref in rec.run_refs %}
        <a href="{{ ref }}/index.html" class="rec-run-link">{{ ref }}</a>{% if not loop.last %}, {% endif %}
        {% endfor %}
      </p>
      {% if rec.dismissed_reason %}
      <p><strong>Dismissed reason:</strong> {{ rec.dismissed_reason }}</p>
      {% endif %}
    </div>
  </details>
  {% if rec.status == 'open' or rec.status == 'in_progress' %}
  <div class="rec-actions">
    <button class="rec-btn rec-btn-fix" onclick="handleFix('{{ rec.id }}')">FIX</button>
    <button class="rec-btn rec-btn-dismiss" onclick="handleDismiss('{{ rec.id }}')">Dismiss</button>
  </div>
  {# FIX result panel — shown after clicking FIX #}
  <div id="fix-result-{{ rec.id }}" class="fix-result-panel" style="display:none">
    <div class="fix-result-inner">
      <strong>✅ Fix prompt written</strong>
      <p class="hint">Run the following command to apply the fix:</p>
      <code class="fix-cmd">chart-test-swarm fix {{ rec.id }}</code>
      <button class="btn-copy" onclick="copyFixCmd('{{ rec.id }}')">Copy</button>
    </div>
  </div>
  {% endif %}
</div>
{% endfor %}

<script>
/* ---- Tab switching ---- */
var currentTab = 'all';

function switchTab(tab) {
  currentTab = tab;
  // Update tab button active state
  document.querySelectorAll('.rec-tab').forEach(function(btn) {
    btn.classList.toggle('rec-tab-active', btn.dataset.tab === tab);
  });
  // Also sync the status dropdown (removed but still filter)
  filterRecommendations();
}

/* ---- Category / severity / tab filter ---- */
function filterRecommendations() {
  var catFilter = document.getElementById('rec-filter-category').value;
  var sevFilter = document.getElementById('rec-filter-severity').value;
  var statFilter = currentTab;  // tab acts as status filter
  var cards = document.querySelectorAll('.rec-card');
  cards.forEach(function(card) {
    var show = true;
    if (catFilter !== 'all' && card.dataset.category !== catFilter) show = false;
    if (sevFilter !== 'all' && card.dataset.severity !== sevFilter) show = false;
    if (statFilter !== 'all' && card.dataset.status !== statFilter) show = false;
    card.style.display = show ? '' : 'none';
  });
}

/* ---- FIX button handler ---- */
function handleFix(recId) {
  var panel = document.getElementById('fix-result-' + recId);
  if (panel) {
    panel.style.display = '';
    panel.scrollIntoView({behavior: 'smooth', block: 'nearest'});
  }
}

function copyFixCmd(recId) {
  var cmd = 'chart-test-swarm fix ' + recId;
  navigator.clipboard.writeText(cmd).then(function() {
    var btns = document.querySelectorAll('#fix-result-' + recId + ' .btn-copy');
    btns.forEach(function(btn) {
      var orig = btn.textContent;
      btn.textContent = 'Copied!';
      setTimeout(function() { btn.textContent = orig; }, 1500);
    });
  });
}

/* ---- Dismiss button handler ---- */
function handleDismiss(recId) {
  var reason = prompt('Dismiss reason:');
  if (reason === null) return;
  // Display a CLI command for the user to run
  var card = document.querySelector('.rec-card[data-status] button.rec-btn-dismiss[onclick*="' + recId + '"]');
  if (card) {
    var actionsDiv = card.closest('.rec-actions');
    if (actionsDiv && !actionsDiv.querySelector('.dismiss-result')) {
      var resultDiv = document.createElement('div');
      resultDiv.className = 'dismiss-result';
      resultDiv.innerHTML = '<strong>⚠️ Dismiss requested</strong>' +
        '<p class="hint">Run the following command to dismiss:</p>' +
        '<code class="fix-cmd">chart-test-swarm dismiss ' + recId + ' --reason "' + reason.replace(/"/g, '\\"') + '"</code>';
      actionsDiv.appendChild(resultDiv);
    }
  }
}
</script>

{% else %}
  <h2>Recommendations</h2>
  <p class="hint">No recommendations available yet. Run scenarios to generate recommendations.</p>
{% endif %}

</section>

</body>
</html>
