# Generic scenario template for chart-test-swarm.
# Carries the project conventions: category, tier, integration|capability,
# id, product, asserts, and generated_by provenance.
#
# For integration mode: fill in integration + category + tier=live|authored-only
# For capability mode:  fill in capability + category=capability + tier=capability
#
# Placeholders use ${VAR} syntax, substituted at render time.

id: ${SCENARIO_ID}
name: "${SCENARIO_NAME}"
description: "${SCENARIO_DESC}"
labels:
  integration: ${INTEGRATION}

cluster:
  provider: kind
  k8s_version: v1.30.0
  preinstall:
    # >>> CLUSTER_PREINSTALL — paste primer's standard preinstall block here
    # For capability mode, leave this section absent (addon-less).

product:
  chart: ${PRODUCT_CHART_PATH}
  release: ${PRODUCT_RELEASE}
  namespace: ${PRODUCT_NAMESPACE}
  values: chart-test/fixtures/${SCENARIO_ID}-values.yaml

asserts:
  - { type: helm-status-deployed, release: ${PRODUCT_RELEASE}, namespace: ${PRODUCT_NAMESPACE} }
  - { type: pods-ready,           namespace: ${PRODUCT_NAMESPACE}, timeout: 5m }
  # Integration: smoke-script assert referencing the scaffolded assert path
  - { type: smoke-script,         path: chart-test/assertions/${SCENARIO_ID}-helm-test.sh }
  # Capability: replace the smoke-script above with a §10.4 capability assert, e.g.:
  # - { type: labels-present, namespace: sample, source: rendered, labels: { ... } }

tags: [nightly, customer-replica]
category: ${CATEGORY}
tier: ${TIER}
# Use one of integration or capability (mutually exclusive per schema):
integration: ${INTEGRATION}
# capability: ${CAPABILITY_NAME}
mechanisms: [addon:${INTEGRATION}, integration:${INTEGRATION}-on-product]

generated_by:
  by: chart-test-swarm-skill
  integration: ${INTEGRATION}
  at: ${GENERATED_AT}
  skill_version: "0.1.0"
