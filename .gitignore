
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Test artifact run dirs (run-stub.sh output) — never commit these
engine/testgrid/reports/run-test-*
reports/run-test-*

# Run dirs the bats suite writes into the sample project. Narrow on purpose:
# the rest of reports/ holds tracked catalog fixtures.
examples/sample-product-chart/chart-test/reports/run-bats-*

# Python bytecode from running the testgrid suite
__pycache__/
*.pyc

# Generated dashboard output. pages.yml rebuilds dist from the canonical
# reports/scenarios sources on every deploy (make publish-dashboard), so the
# committed copies were never consumed — only churn.
**/reports/dist/

# Relay harness scratch dir
.relay/
